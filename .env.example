# ==============================================================================
# YARDS & PARTS AUTOMOTIVE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your credentials.
# NEVER commit the real .env file to git.
# ==============================================================================

# ── Twilio Telephony (Live Voice IVR Dialogue & SMS Follow-ups) ─────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
VERIFIED_TEST_PHONE=+1xxxxxxxxxx

# ── Zoho CRM Integration (OAuth 2.0 & Pipeline Lead Sync) ─────────────────────
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token_here
ZOHO_REDIRECT_URI=http://localhost:8000/oauth/callback

# ── Gmail SMTP Dispatch (Formal PDF Quotes & Auto-Mailer) ─────────────────────
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
SENDER_EMAIL=your_email@gmail.com
SENDER_NAME=Yards & Parts Automotive

# ── B2B Outbound Webhooks & HMAC Signature ─────────────────────────────────────
CRM_WEBHOOK_SECRET=your_webhook_hmac_secret_here
CRM_WEBHOOK_URL=https://crm.yourcompany.com/api/v1/events

# ── Application Runtime & Tunnel Settings ──────────────────────────────────────
APP_ENV=development
DATABASE_URL=sqlite:///./cadence.db
TWIML_BASE_URL=https://your-public-tunnel.trycloudflare.com
